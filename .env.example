# Required: the bot token from the Discord developer portal. Never commit a real one.
DISCORD_TOKEN=

# Required: the only guild the bot will ever act in (numeric guild ID).
TARGET_GUILD_ID=

# Optional: the name everyone becomes. Unset or empty means "We".
# Values Discord would reject (visibly empty, longer than 32 characters,
# control characters) are refused with a warning and fall back to "We".
#OUR_NAME=We

# Optional: tracing filter (e.g. info, debug, or a full tracing directive).
#LOG_LEVEL=info

# Optional: low-frequency periodic full-guild repair sweep, in seconds.
# Unset or 0 disables it; the gateway events remain the fast path.
#RECONCILE_INTERVAL_SECONDS=3600
